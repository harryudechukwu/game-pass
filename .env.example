# MongoDB connection.
#  • Local: your local MongoDB (mongodb://localhost:27017).
#  • Netlify/production: your MongoDB Atlas SRV string
#    (mongodb+srv://user:pass@cluster.xxxx.mongodb.net) — set as a site env var.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="gamepass"

# Session cookie signing secret (min 32 bytes).
AUTH_SECRET="change-me-to-a-random-32-byte-string"
