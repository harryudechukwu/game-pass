# MongoDB connection — REQUIRED (the app has no localhost fallback).
#  • Shared/production: your MongoDB Atlas SRV string. Use the same one locally
#    so dev and live share data. Set it as a site env var in your host.
#  • Or a local mongod: mongodb://localhost:27017
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxx.mongodb.net"
MONGODB_DB="gamepass"

# Session cookie signing secret (min 32 bytes) — REQUIRED in production.
# Without it the server refuses to run in prod (no insecure default fallback).
AUTH_SECRET="change-me-to-a-random-32-byte-string"

# Owner admin login. Set these to create / rotate the admin account; the
# password is stored hashed (scrypt), never in the clear. To change the admin
# password, change ADMIN_PASSWORD and redeploy.
ADMIN_EMAIL="you@yourvenue.com"
ADMIN_PASSWORD="set-a-strong-password"
ADMIN_NAME="Administrator"
