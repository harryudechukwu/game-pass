# MongoDB connection — REQUIRED (the app has no localhost fallback).
#  • Shared/production: your MongoDB Atlas SRV string. Use the same one locally
#    so dev and live share data. Set it as a site env var in your host.
#  • Or a local mongod: mongodb://localhost:27017
MONGODB_URI="mongodb+srv://user:pass@cluster.xxxx.mongodb.net"
MONGODB_DB="gamepass"

# Session cookie signing secret (min 32 bytes).
AUTH_SECRET="change-me-to-a-random-32-byte-string"
